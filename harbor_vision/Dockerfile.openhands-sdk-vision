# Prebaked agent base image: OpenHands SDK carrying the PR5460 image-serialization fix.
#
# Harbor's `openhands-sdk` adapter installs the SDK at /opt/openhands-sdk-venv and
# skips that step when the venv already imports openhands.sdk. Its `version` kwarg
# can only express an exact PyPI release (`openhands-sdk==<v>`), so a pinned commit
# cannot be requested through it. Baking the venv here is the supported route.
#
# The pin is the head of OpenHands/software-agent-sdk#5460, which stops the forced
# string serializer from dropping ImageContent when vision is active. Released
# 1.50.1 drops images even with capability_overrides, so this commit (or its
# eventual release) is required for any DeepSeek multimodal Harbor measurement.
#
# Both packages ship into the same `openhands/` namespace directory. Installing
# them from a source checkout makes uv create *editable* installs, which write a
# `__editable__` finder pointing at the source tree instead of copying packages;
# deleting that tree leaves `openhands.tools` importable but `openhands.sdk`
# missing. Building wheels first avoids that failure mode entirely.
#
# Build:
#   docker build -f harbor_vision/Dockerfile.openhands-sdk-vision \
#     -t material-harbor/openhands-sdk-vision:dad4aa5 harbor_vision
FROM python:3.12-slim@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea AS sdkbuild

ARG SDK_COMMIT=dad4aa50208c27bf60cea4040b1db4dee2fd71c3
ARG SDK_REPO=https://github.com/OpenHands/software-agent-sdk.git

RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates \
 && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.9.9 /uv /usr/local/bin/uv

RUN set -eux; \
    git clone --quiet --filter=blob:none --no-checkout "$SDK_REPO" /tmp/sdk; \
    cd /tmp/sdk; \
    git fetch --quiet --depth 1 origin "$SDK_COMMIT"; \
    git checkout --quiet "$SDK_COMMIT"; \
    test "$(git rev-parse HEAD)" = "$SDK_COMMIT"; \
    uv build --wheel --out-dir /tmp/wheels openhands-sdk; \
    uv build --wheel --out-dir /tmp/wheels openhands-tools


FROM python:3.12-slim@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea

ARG SDK_COMMIT=dad4aa50208c27bf60cea4040b1db4dee2fd71c3

# `curl` is required by Harbor's adapter for its `stdbuf -oL | tee` pipe.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl \
 && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.9.9 /uv /usr/local/bin/uv
COPY --from=sdkbuild /tmp/wheels /tmp/wheels

RUN set -eux; \
    uv venv /opt/openhands-sdk-venv --python 3.12; \
    uv pip install --python /opt/openhands-sdk-venv/bin/python \
        /tmp/wheels/openhands_sdk-1.50.1-py3-none-any.whl \
        /tmp/wheels/openhands_tools-1.50.1-py3-none-any.whl \
        fastapi; \
    /opt/openhands-sdk-venv/bin/python -c "import openhands.sdk, openhands.tools.file_editor, openhands.tools.terminal, openhands.tools.task_tracker; print('sdk', openhands.sdk.__version__)"; \
    printf '%s\n' "$SDK_COMMIT" > /opt/openhands-sdk-commit.txt; \
    rm -rf /tmp/wheels
